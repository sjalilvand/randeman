# نمونه پیکربندی — این فایل را به config/.env کپی و مقادیر را تنظیم کنید.
# اسرار در کد یا پوشه عمومی نگه‌داری نمی‌شود (سند ۱۳.۲).
# تصمیم‌های قطعی موارد باز سند ۲۵.۲: docs/04-DECISIONS-25-2.md

RANDEMAN_ENV=prod
RANDEMAN_DATABASE_URL=postgresql+psycopg://randeman_app:CHANGE_ME@127.0.0.1:5432/randeman

RANDEMAN_SESSION_COOKIE_NAME=randeman_session
RANDEMAN_SESSION_TTL_MINUTES=480
# true فقط در عملیات پشت HTTPS (Caddy/Nginx). برای راه‌اندازی سریع HTTP روی 8095،
# start-randeman.ps1 خودش برای همان فرایند false می‌کند — نیازی به تغییر اینجا نیست.
RANDEMAN_COOKIE_SECURE=true

RANDEMAN_DOCUMENTS_DIR=C:/randeman/data/documents
RANDEMAN_QUARANTINE_DIR=C:/randeman/data/quarantine
RANDEMAN_EXPORTS_DIR=C:/randeman/data/exports
RANDEMAN_MAX_UPLOAD_MB=20
# pdf,docx,xlsx,pptx,jpg,jpeg,png,txt — تصمیم ۲۵.۲ (سهمیه ۲۰MB، نگهداری ۳ سال)
RANDEMAN_ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,jpg,jpeg,png,txt

# ClamAV موجود روی سرور (پورت 3310) — آزمون: deploy\windows\test-clamav.ps1 و /readyz
RANDEMAN_CLAMD_HOST=127.0.0.1
RANDEMAN_CLAMD_PORT=3310

# تقویم (تصمیم ۲۵.۲: هفته شنبه‌شروع، مهلت گزارش پنجشنبه ۱۲:۰۰ تهران)
RANDEMAN_TIMEZONE_NAME=Asia/Tehran
RANDEMAN_DEFAULT_WEEKLY_CAPACITY_HOURS=40
RANDEMAN_REPORT_DEADLINE_WEEKDAY=3
RANDEMAN_REPORT_DEADLINE_HOUR=12

# حالت تک‌پورت — رابط ساخته‌شده از همان پورت API ارائه می‌شود (پورت 8095).
# برای عملیات پایدار با Nginx 8087 خالی بگذارید؛ برای start-randeman.ps1 مقدار زیر را بگذارید.
# RANDEMAN_SERVE_DIST_DIR=C:/randeman/releases/v1.0.0/frontend/dist

# اعلان ایمیلی — فاز ۲ (تصمیم ۲۵.۲: SMTP داخلی سازمان؛ خالی = اعلان درون‌برنامه‌ای فقط)
RANDEMAN_SMTP_HOST=
RANDEMAN_SMTP_PORT=587
RANDEMAN_SMTP_USER=
RANDEMAN_SMTP_PASSWORD=
RANDEMAN_SMTP_FROM=

# در عملیات OpenAPI عمومی نباشد
RANDEMAN_DOCS_ENABLED=false
RANDEMAN_TRUSTED_PROXIES=127.0.0.1
RANDEMAN_CORS_ORIGINS=
